use tpt_phys_core::MaterialRegistry;
use tpt_phys_dem::particle::Particle;
use tpt_phys_dem::world::World;

/// Run a minimal end-to-end demo: a self-weight granular pile settling under
/// gravity, using the material database and the DEM `World`.
pub fn main() {
    let steel = MaterialRegistry::with_defaults()
        .get("Structural Steel")
        .unwrap()
        .clone();
    let ps = vec![Particle::new([0.0, 1.0, 0.0], [0.0; 3], 0.5, steel.density)];
    let mut world = World::new(ps, 2e-4);
    for _ in 0..4000 {
        world.step();
    }
    println!(
        "{{project-name}}: settled kinetic energy = {:.4e} J",
        world.kinetic_energy()
    );
}
