use tpt_physics_core::MaterialRegistry;
use tpt_physics_fea::spec::{DomainSpec, LoadSpec, ProblemSpec, SolverSpec};

/// Run a minimal end-to-end validate: a self-weight box solve.
pub fn main() {
    let spec = ProblemSpec {
        materials: None,
        material: tpt_physics_fea::spec::MaterialRef::Inline(tpt_physics_core::Material::new(
            "Steel", 200e9, 0.3, 7850.0, 12e-6,
        )),
        domain: DomainSpec::Box {
            min: [0.0, 0.0, 0.0],
            max: [1.0, 1.0, 1.0],
            n: [4, 4, 4],
        },
        boundary_conditions: tpt_physics_fea::spec::BcSpec {
            fixed_planes: vec!["y_min".to_string()],
        },
        loads: LoadSpec {
            self_weight: true,
            gravity: 9.81,
        },
        solver: SolverSpec::StaticLinear,
    };
    let solved = spec.solve(&MaterialRegistry::new()).unwrap();
    println!(
        "{{project-name}}: solved {} nodes, top settlement = {:.3e} m",
        solved.n_nodes, solved.free_top_settlement_y
    );
}
